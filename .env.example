# Application
APP_NAME=legal-rag-engine
APP_ENV=development
DEBUG=true
LOG_LEVEL=INFO

# Database (PostgreSQL + pgvector; matches docker-compose.yml by default)
DATABASE_URL=postgresql+psycopg://legal_rag:legal_rag@localhost:5432/legal_rag

# Embeddings: local-first by default (wired in later phases)
EMBEDDING_PROVIDER=local
EMBEDDING_MODEL=

# Generation: mock/local for tests and zero-cost demos (wired in later phases)
GENERATION_PROVIDER=mock
LOCAL_LLM_MODEL=

# Retrieval strategy (dense_only | sparse_only | hybrid — engine not implemented yet)
RETRIEVAL_MODE=hybrid
